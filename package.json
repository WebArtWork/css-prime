{
    "name": "css-prime-monorepo",
    "version": "0.7.0",
    "private": true,
    "description": "css-prime is an independent MIT-licensed continuation of the archived PrimeUIX codebase, maintained by Web Art Work.",
    "author": "Web Art Work",
    "contributors": [
        "PrimeTek Informatics",
        "Web Art Work"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/WebArtWork/css-prime.git"
    },
    "license": "MIT",
    "homepage": "https://github.com/WebArtWork/css-prime#readme",
    "bugs": {
        "url": "https://github.com/WebArtWork/css-prime/issues"
    },
    "workspaces": [
        "packages/*",
        "apps/*"
    ],
    "scripts": {
        "setup": "npm run init",
        "clean": "npx rimraf --glob **/node_modules **/dist",
        "init": "npm install && husky",
        "link": "npm run dev:link --workspaces --if-present",
        "changeset": "changeset",
        "version:packages": "changeset version",
        "release:check": "npm run lint && npm run format:check && npm run type:check && npm run test && npm run build",
        "publish": "npm run release:check && npm publish --workspaces",
        "publish:dry-run": "npm run release:check && npm publish --workspaces --dry-run",
        "publish:alpha": "npm run release:check && npm publish --workspace=packages/headless --tag alpha",
        "build": "cross-env NODE_ENV=production npm run build:check && npm run build:packages",
        "build:dev": "cross-env NODE_ENV=development npm run build:dev:packages",
        "build:check": "npm run format:check && npm run security:check",
        "build:packages": "npm run build:utils && npm run build:forms && npm run build:headless && npm run build:locale && npm run build:motion && npm run build:styled && npm run build:styles && npm run build:themes && npm run build:mcp",
        "build:dev:packages": "npm run build:dev --workspaces --if-present",
        "build:forms": "npm run build --workspace=packages/forms",
        "build:headless": "npm run build --workspace=packages/headless",
        "build:locale": "npm run build --workspace=packages/locale",
        "build:mcp": "npm run build --workspace=packages/mcp",
        "build:motion": "npm run build --workspace=packages/motion",
        "build:styled": "npm run build --workspace=packages/styled",
        "build:styles": "npm run build --workspace=packages/styles",
        "build:themes": "npm run build --workspace=packages/themes",
        "build:utils": "npm run build --workspace=packages/utils",
        "playground:dev": "npm run dev --workspace=apps/playground",
        "type:check": "npm run type:check --workspaces --if-present",
        "test": "npm run test --workspaces --if-present",
        "test:locale": "npm run test --workspace=packages/locale",
        "security:check": "npm audit --omit=dev --audit-level=high",
        "format": "prettier --write \"**/*.{js,mjs,ts,mts,d.ts}\"",
        "format:check": "prettier --check \"**/*.{js,mjs,ts,mts,d.ts}\" ",
        "lint": "eslint packages/*/src packages/*/scripts apps/*/src apps/*/scripts scripts packages/*/*.config.* *.config.* --no-error-on-unmatched-pattern",
        "lint:fix": "eslint packages/*/src packages/*/scripts apps/*/src apps/*/scripts scripts packages/*/*.config.* *.config.* --no-error-on-unmatched-pattern --fix"
    },
    "overrides": {
        "@hono/node-server": "^1.19.10",
        "path-to-regexp": "^8.4.0"
    },
    "devDependencies": {
        "@babel/preset-env": "^7.21.5",
        "@changesets/changelog-github": "^1.0.0",
        "@changesets/cli": "^2.27.10",
        "@commitlint/cli": "^19.6.1",
        "@commitlint/config-conventional": "^19.6.0",
        "@types/jest": "^27.4.0",
        "concurrently": "^9.1.2",
        "cross-env": "^7.0.3",
        "eslint": "^9.19.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-jest": "^28.11.0",
        "fs-extra": "^11.2.0",
        "glob": "^10.4.2",
        "husky": "^9.1.6",
        "jest": "^29.7.0",
        "js-yaml": "^4.1.0",
        "known-css-properties": "^0.37.0",
        "lint-staged": "^12.0.0",
        "prettier": "^3.3.2",
        "rimraf": "^6.0.1",
        "terser": "^5.38.2",
        "ts-jest": "^29.2.5",
        "ts-node": "^10.4.0",
        "tsup": "^8.1.0",
        "typedoc": "0.27.6",
        "typescript": "^5.6.3",
        "typescript-eslint": "^8.22.0"
    },
    "publishConfig": {
        "access": "public"
    },
    "engines": {
        "node": ">=24 <25"
    },
    "lint-staged": {
        "**/*.{js,mjs,ts,mts,d.ts,yml}": [
            "prettier --write"
        ]
    }
}
