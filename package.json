{
    "name": "css-prime-monorepo",
    "version": "0.7.0",
    "private": true,
    "description": "css-prime is an independent MIT-licensed continuation of the archived PrimeUIX codebase, maintained by Web Art Work.",
    "author": "Web Art Work",
    "contributors": [
        "PrimeTek Informatics",
        "Web Art Work"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/WebArtWork/css-prime.git"
    },
    "license": "MIT",
    "homepage": "https://github.com/WebArtWork/css-prime#readme",
    "bugs": {
        "url": "https://github.com/WebArtWork/css-prime/issues"
    },
    "scripts": {
        "setup": "pnpm run init",
        "clean": "npx rimraf --glob **/node_modules **/dist",
        "init": "pnpm install && husky",
        "link": "pnpm --filter \"./packages/*\" dev:link",
        "changeset": "changeset",
        "version:packages": "changeset version",
        "release:check": "pnpm run lint && pnpm run format:check && pnpm run type:check && pnpm run test && pnpm run build",
        "release": "pnpm run release:check && pnpm -r publish --filter \"./packages/*\" --no-git-checks --report-summary",
        "release:alpha": "pnpm run release:check && pnpm --filter @wawjs/css-prime-headless publish --no-git-checks --report-summary --tag alpha",
        "build": "cross-env NODE_ENV=production pnpm run build:check && pnpm run build:packages",
        "build:dev": "cross-env NODE_ENV=development pnpm run build:dev:packages",
        "build:check": "pnpm run format:check && pnpm run security:check",
        "build:packages": "pnpm --filter \"./packages/*\" --workspace-concurrency=1 run build",
        "build:dev:packages": "pnpm --filter \"./packages/*\" --workspace-concurrency=1 --parallel run build:dev",
        "build:forms": "pnpm --filter forms build",
        "build:headless": "pnpm --filter headless build",
        "build:locale": "pnpm --filter locale build",
        "build:mcp": "pnpm --filter mcp build",
        "build:motion": "pnpm --filter motion build",
        "build:styled": "pnpm --filter styled build",
        "build:styles": "pnpm --filter styles build",
        "build:themes": "pnpm --filter themes build",
        "build:utils": "pnpm --filter utils build",
        "playground:dev": "pnpm --filter playground dev",
        "type:check": "pnpm -r run type:check",
        "test": "pnpm -r run test",
        "test:locale": "pnpm --filter locale test",
        "security:check": "pnpm audit --production --audit-level high",
        "format": "prettier --write \"**/*.{js,mjs,ts,mts,d.ts}\"",
        "format:check": "prettier --check \"**/*.{js,mjs,ts,mts,d.ts}\" ",
        "lint": "eslint packages/*/src packages/*/scripts apps/*/src apps/*/scripts scripts packages/*/*.config.* *.config.* --no-error-on-unmatched-pattern",
        "lint:fix": "eslint packages/*/src packages/*/scripts apps/*/src apps/*/scripts scripts packages/*/*.config.* *.config.* --no-error-on-unmatched-pattern --fix"
    },
    "devDependencies": {
        "@babel/preset-env": "^7.21.5",
        "@changesets/changelog-github": "^1.0.0",
        "@changesets/cli": "^2.27.10",
        "@commitlint/cli": "^19.6.1",
        "@commitlint/config-conventional": "^19.6.0",
        "@types/jest": "^27.4.0",
        "concurrently": "^9.1.2",
        "cross-env": "^7.0.3",
        "eslint": "^9.19.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-jest": "^28.11.0",
        "fs-extra": "^11.2.0",
        "glob": "^10.4.2",
        "husky": "^9.1.6",
        "jest": "^29.7.0",
        "js-yaml": "^4.1.0",
        "known-css-properties": "^0.37.0",
        "lint-staged": "^12.0.0",
        "prettier": "^3.3.2",
        "rimraf": "^6.0.1",
        "terser": "^5.38.2",
        "ts-jest": "^29.2.5",
        "ts-node": "^10.4.0",
        "tsup": "^8.1.0",
        "typedoc": "0.27.6",
        "typescript": "^5.6.3",
        "typescript-eslint": "^8.22.0"
    },
    "publishConfig": {
        "access": "public"
    },
    "engines": {
        "node": ">=24 <25"
    },
    "packageManager": "pnpm@9.6.0",
    "lint-staged": {
        "**/*.{js,mjs,ts,mts,d.ts,yml}": [
            "prettier --write"
        ]
    }
}
