{
    "name": "@wawjs/css-prime-mcp",
    "version": "1.1.0",
    "author": "Web Art Work",
    "description": "Model Context Protocol (MCP) server for css-prime",
    "keywords": [
        "css-prime",
        "mcp",
        "model-context-protocol",
        "ai",
        "llm"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/WebArtWork/css-prime.git",
        "directory": "packages/mcp"
    },
    "bugs": {
        "url": "https://github.com/WebArtWork/css-prime/issues"
    },
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "sideEffects": false,
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "cross-env NODE_ENV=production INPUT_DIR=src/ OUTPUT_DIR=dist/ npm run build:package",
        "build:dev": "cross-env NODE_ENV=development INPUT_DIR=src/ OUTPUT_DIR=dist/ npm run build:dev:package",
        "build:package": "tsup",
        "build:dev:package": "tsup --watch",
        "dev:link": "npm link"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.30.0",
        "zod": "^3.25.76"
    },
    "engines": {
        "node": ">=24 <25"
    }
}
