{
    "name": "@wawjs/css-prime-styled",
    "version": "1.1.0",
    "author": "Web Art Work",
    "description": "Framework-neutral styling utilities for css-prime",
    "keywords": [
        "css-prime",
        "styled",
        "css",
        "style utilities"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/WebArtWork/css-prime.git",
        "directory": "packages/styled"
    },
    "bugs": {
        "url": "https://github.com/WebArtWork/css-prime/issues"
    },
    "main": "./dist/index.mjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs",
            "default": "./dist/index.mjs"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "sideEffects": false,
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "cross-env NODE_ENV=production INPUT_DIR=src/ OUTPUT_DIR=dist/ npm run build:package",
        "build:dev": "cross-env NODE_ENV=development INPUT_DIR=src/ OUTPUT_DIR=dist/ npm run build:dev:package",
        "build:package": "tsup",
        "build:dev:package": "tsup --watch",
        "dev:link": "npm link"
    },
    "dependencies": {
        "@wawjs/css-prime-utils": "^1.1.0"
    },
    "engines": {
        "node": ">=24 <25"
    }
}
