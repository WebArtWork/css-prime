{
    "name": "@wawjs/css-prime-styles",
    "version": "1.1.0",
    "author": "Web Art Work",
    "description": "Framework-neutral component style definitions for css-prime",
    "keywords": [
        "css-prime",
        "styles",
        "css",
        "style utilities"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/WebArtWork/css-prime.git",
        "directory": "packages/styles"
    },
    "bugs": {
        "url": "https://github.com/WebArtWork/css-prime/issues"
    },
    "main": "./dist/index.mjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs",
            "default": "./dist/index.mjs"
        },
        "./*": {
            "types": "./dist/types.d.mts",
            "import": "./dist/*/index.mjs",
            "default": "./dist/*/index.mjs"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "sideEffects": false,
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "cross-env NODE_ENV=production INPUT_DIR=src/ OUTPUT_DIR=dist/ npm run build:package",
        "build:dev": "cross-env NODE_ENV=development INPUT_DIR=src/ OUTPUT_DIR=dist/ npm run build:dev:package",
        "build:package": "npm run build:prebuild && npm run build:clean && tsup",
        "build:dev:package": "npm run build:prebuild && tsup --watch",
        "build:clean": "rimraf dist",
        "build:prebuild": "node ./scripts/prebuild.mjs",
        "type:check": "tsc --noEmit",
        "dev:link": "npm link"
    },
    "dependencies": {
        "@wawjs/css-prime-styled": "^1.1.0"
    },
    "engines": {
        "node": ">=24 <25"
    }
}
