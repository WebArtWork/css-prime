{
    "name": "@wawjs/css-prime-themes",
    "version": "1.1.0",
    "author": "Web Art Work",
    "description": "Framework-neutral theme presets and tokens for css-prime",
    "keywords": [
        "css-prime",
        "themes",
        "css",
        "design tokens"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/WebArtWork/css-prime.git",
        "directory": "packages/themes"
    },
    "bugs": {
        "url": "https://github.com/WebArtWork/css-prime/issues"
    },
    "main": "./dist/index.mjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs",
            "default": "./dist/index.mjs"
        },
        "./types": {
            "types": "./types/index.d.ts"
        },
        "./types/*": {
            "types": "./types/*/index.d.ts"
        },
        "./tokens": {
            "types": "./tokens/index.d.ts",
            "import": "./tokens/index.mjs",
            "default": "./tokens/index.mjs"
        },
        "./*": {
            "types": "./dist/*/index.d.ts",
            "import": "./dist/*/index.mjs",
            "default": "./dist/*/index.mjs"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "sideEffects": false,
    "files": [
        "dist",
        "umd",
        "tokens",
        "types",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "cross-env NODE_ENV=production INPUT_DIR=src/ OUTPUT_DIR=dist/ pnpm run build:package",
        "build:dev": "cross-env NODE_ENV=development INPUT_DIR=src/ OUTPUT_DIR=dist/ pnpm run build:dev:package",
        "build:package": "pnpm run type:check && pnpm run build:tokens && pnpm run build:clean && pnpm run build:esm && pnpm run build:umd && pnpm run build:tokens:bundle && pnpm run build:postbuild",
        "build:dev:package": "pnpm run build:tokens && pnpm run build:esm --watch && pnpm run build:postbuild",
        "build:clean": "rimraf dist umd tokens",
        "build:esm": "cross-env CSS_PRIME_BUILD_TARGET=esm tsup",
        "build:postbuild": "node ./scripts/postbuild.mjs",
        "build:tokens": "node ./scripts/build-tokens.mjs",
        "build:tokens:bundle": "cross-env CSS_PRIME_BUILD_TARGET=tokens tsup",
        "build:umd": "node ./scripts/build-umd.mjs",
        "type:check": "tsc --noEmit",
        "dev:link": "pnpm link --global && npm link"
    },
    "dependencies": {
        "@wawjs/css-prime-styled": "workspace:^"
    },
    "engines": {
        "node": ">=24 <25"
    }
}
